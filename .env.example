# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co

# Clé publique (anon / publishable) : LECTURE seule, inlinée dans le bundle
# navigateur. C'est normal et sans risque tant que la RLS n'autorise que
# `select` (cf. supabase/migrations/0001_rls_lecture_publique.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role : SECRET. Contourne la RLS, ne doit JAMAIS être préfixée
# NEXT_PUBLIC_ (elle serait publiée dans le bundle).
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe unique d'accès à l'app. Requis : sans lui l'app refuse de
# vérifier les sessions.
APP_PASSWORD=

# Clé de signature du cookie de session (ex. `openssl rand -base64 32`).
# Optionnelle : à défaut, dérivée d'APP_PASSWORD — changer le mot de passe
# invalide alors les sessions ouvertes.
AUTH_SECRET=

# The Odds API (the-odds-api.com) — cotes bookmakers, pour le SEUL écran de
# mesure /calibration/cotes. Optionnelle : sans elle, l'écran reste consultable
# (il lit le cache tn_odds), seule la récupération de nouvelles cotes est
# désactivée. Palier gratuit : 500 requêtes/mois, 1 crédit par récupération.
# Rien de ce qui en dérive n'est branché dans les picks, le fantasy ou la
# simulation.
ODDS_API_KEY=
